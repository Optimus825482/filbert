# Local development database. Do not commit real passwords to .env files.
DATABASE_URL="postgresql://filbert_app:CHANGE_ME@localhost:5432/filbert?schema=public"

# Yalnızca yerelde `pnpm prisma migrate dev` çalıştırırken gerekir.
# Üretimde `prisma migrate deploy` kullanıldığı için tanımlanmasına gerek yoktur.
SHADOW_DATABASE_URL="postgresql://filbert_app:CHANGE_ME@localhost:5432/filbert_shadow?schema=public"

# The application uses port 3066 for both development and production scripts.
PORT=3066

# System administrator credentials. Keep real values only in .env, never source control.
SYSTEM_ADMIN_MAIL="admin@example.com"
SYSTEM_ADMIN_PASS="replace-with-a-long-unique-administrator-password"

# Required only for the one-time /setup screen. Keep it distinct from the
# administrator password and rotate/remove it after initial setup.
SYSTEM_MAIN_PASS="replace-with-a-high-entropy-setup-secret"
